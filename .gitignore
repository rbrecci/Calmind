# ---------------------------------------------------------------
# Calmind - Saude Mental & Acolhimento
# Ajustado em 20/08/2026: o Laravel nao fica na raiz, fica em
# backend/. Regras ancoradas em / paravam de casar por causa disso.
# ---------------------------------------------------------------

# dependencias (sem barra inicial: casa em qualquer profundidade)
vendor/
node_modules/

# ambiente e segredos (RNF-56: chave nunca no repositorio)
.env
.env.*
!.env.example
*.pem
*.keystore
*.jks

# backend Laravel
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/logs/
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
.phpunit.result.cache
.phpunit.cache/

# app React Native
.expo/
app/android/build/
app/android/.gradle/
app/android/app/build/
app/ios/build/
app/ios/Pods/
*.apk
*.aab
*.ipa

# build generico
dist/
build/

# ---------------------------------------------------------------
# pesquisa de campo: audio de entrevista NUNCA entra no repositorio
# (secao 3 de docs/pesquisa/roteiro-entrevistas.md). As sinteses
# anonimizadas em Markdown entram normalmente.
# ---------------------------------------------------------------
*.m4a
*.mp3
*.wav
*.ogg
*.aac

# editor e sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# material do professor, mantido so na maquina do grupo
# (documento de terceiro, o repositorio pode ser publico)
EscopoSCRUM*.pdf
