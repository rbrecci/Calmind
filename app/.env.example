# Copie este arquivo para `.env` (o git ignora) e ajuste.
# O Expo só embute no app variáveis que começam com EXPO_PUBLIC_, e elas ficam visíveis
# dentro do APK: nunca coloque senha, chave ou token aqui.

# true: o app responde com dados de mentira (src/api/mock.ts), sem precisar do backend.
# false: o app chama a API de verdade na URL abaixo.
EXPO_PUBLIC_USE_MOCK=false

# URL da API com o prefixo /api/v1 (contrato 2.1). Só é lida com USE_MOCK=false.
# O celular não enxerga o localhost do notebook (decisão DA-01): para testar fora do
# emulador, use o IP da máquina na rede.
EXPO_PUBLIC_API_URL=http://192.168.15.3:8000/api/v1

# Atalho de login de teste (calmind://demo-login?as=<chave> e botões "Entrar como" no login).
# Só liga com EXPO_PUBLIC_DEMO_LOGIN=true e a senha preenchida; as chaves estão em
# src/auth/demo-accounts.ts. Atenção: como toda EXPO_PUBLIC_, a senha fica legível dentro do
# APK. Use só em APK de teste, com a senha das contas de demonstração (CALMIND_DEMO_PASSWORD do backend/.env),
# que o admin não usa (ele tem a CALMIND_ADMIN_PASSWORD) e por isso pode vazar sem abrir o painel;
# o APK da apresentação sai com a flag desligada.
EXPO_PUBLIC_DEMO_LOGIN=false
EXPO_PUBLIC_DEMO_PASSWORD=
