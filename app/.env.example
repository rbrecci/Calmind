# Copie este arquivo para `.env` (o git ignora) e ajuste.
# O Expo só embute no app variáveis que começam com EXPO_PUBLIC_, e elas ficam visíveis
# dentro do APK: nunca coloque senha, chave ou token aqui.

# true: o app responde com dados de mentira (src/api/mock.ts), sem precisar do backend.
# false: o app chama a API de verdade na URL abaixo.
EXPO_PUBLIC_USE_MOCK=true

# URL da API com o prefixo /api/v1 (contrato 2.1). Só é lida com USE_MOCK=false.
# O celular não enxerga o localhost do notebook (decisão DA-01): para testar fora do
# emulador, use o IP da máquina na rede.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
