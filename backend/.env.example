APP_NAME=Calmind
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=calmind
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

INVITATION_TTL_DAYS=7
INVITATION_MAX_ATTEMPTS=5
INVITATION_ATTEMPT_WINDOW_MINUTES=15

AUTH_INACTIVITY_MINUTES=30

# Analise semanal por IA (RF-41). A chave vem do Google AI Studio e NUNCA vai para o repositorio.
# AI_PROVIDER: gemini (real) ou simulated (ensaio sem chave, texto marcado como SIMULADO)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_CA_BUNDLE=C:/caminho/cacert.pem  (so se o PHP da maquina nao tiver certificados raiz: "cURL error 60")
# Rodizio (todas as chaves de contas do dono do projeto). GEMINI_API_KEY e a primeira; as demais, separadas por virgula:
# GEMINI_API_KEYS=chave2,chave3
# Ordem de queda dos modelos quando um esta sobrecarregado (503) ou sem cota (429); sem ela vale GEMINI_MODEL:
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# Tempo por tentativa e total da chamada, em segundos:
# AI_TIMEOUT=25
# AI_BUDGET=70
